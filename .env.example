# Use Neon for the web app, or the local Compose database during offline development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aamish

# Use a long random value in production.
SESSION_SECRET=replace-with-a-long-random-secret

# Used only by `bun run bootstrap:admin`; do not expose these to the browser.
BOOTSTRAP_ADMIN_USERNAME=aamish.admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Aamish Platform Admin

# Signed package and review-photo uploads.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
